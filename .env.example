# Copie para .env (cp .env.example .env). NUNCA versione o .env.
APP_VERSION=1.0.0
APP_PORT=3000
# 127.0.0.1 = acessível só nesta máquina (recomendado). 0.0.0.0 = acessível pela rede local.
APP_BIND=127.0.0.1
DB_USER=estulanches
# OBRIGATÓRIA. Gere uma senha forte: openssl rand -hex 24
# Atenção: o Postgres só lê esta senha na PRIMEIRA criação do volume pgdata.
DB_PASSWORD=troque_esta_senha
DB_NAME=estulanches
